# Central configuration for all services
# -------------------------------------------------
# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tagr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Full DB URL for services
DATABASE_URL=postgresql+psycopg://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB

# MinIO (object storage)
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Storage endpoint and credentials
STORAGE_ENDPOINT=http://$MINIO_HOST:${MINIO_PORT}
STORAGE_ACCESS_KEY=$MINIO_ROOT_USER
STORAGE_SECRET_KEY=$MINIO_ROOT_PASSWORD

# Web (static UI) service
WEB_HOST=localhost
WEB_PORT=8000

# Inference service
INFERENCE_HOST=localhost
INFERENCE_PORT=8001
INFERENCE_DEVICE=cpu
# Optional base path if you want the API to be prefixed, e.g., /api
INFERENCE_BASE_PATH=
