# =============================================================================
# Database — Supabase Supavisor POOLER (recommended)
# =============================================================================
# When the three pooler vars below are set, DATABASE_URL is built automatically
# and takes priority over a manual DATABASE_URL.
#
# Dashboard: Project Settings -> Database -> Connection string -> Pooler
#
# Transaction mode (default, port 6543) — best for app servers / Docker:
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
SUPABASE_POOLER_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_POOLER_PORT=6543
SUPABASE_DB_NAME=postgres
#
# Session mode alternative (port 5432 on the pooler host, same user format):
# SUPABASE_POOLER_PORT=5432
#
# Or pass a full URL instead (direct or pooler) — used only when pooler vars above are unset:
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

DB_POOL_PRE_PING=true
DB_ECHO=false

# =============================================================================
# Supabase Auth
# =============================================================================
# --- Supabase Auth ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Legacy fallback (older projects only):
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret
#
# Signup uses POST /auth/register (admin API, email_confirm=true) so no confirmation
# email is sent and built-in Supabase SMTP rate limits are avoided.

# =============================================================================
# Object storage — Supabase Storage (S3-compatible, ap-southeast-1)
# =============================================================================
# Dashboard: Storage -> S3 Access -> generate access key + secret
# Create a PUBLIC bucket named tagr-bucket (or set STORAGE_BUCKET below).
#
# STORAGE_ENDPOINT is auto-built from SUPABASE_PROJECT_REF when unset:
#   https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=tagr-bucket
STORAGE_ACCESS_KEY=your_s3_access_key_id
STORAGE_SECRET_KEY=your_s3_secret_access_key
# Public object base (auto-built from SUPABASE_URL when unset):
# STORAGE_PUBLIC_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/tagr-bucket
STORAGE_SIGNATURE_VERSION=s3v4
# Browser direct uploads use presigned PUT URLs (see POST /photos/upload/presign).
# Allow your app origin on the bucket CORS policy in Supabase Dashboard -> Storage -> tagr-bucket -> Configuration.
PRESIGNED_UPLOAD_EXPIRES_SECONDS=900

# --- Local MinIO (optional: docker compose --profile minio up) ---
# MINIO_HOST=localhost
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# STORAGE_ENDPOINT=http://storage:9000
# STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_REGION=us-east-1

# =============================================================================
# FastAPI web server
# =============================================================================
WEB_PORT=8787
CORS_ALLOW_ORIGINS=*

SIMILARITY_THRESHOLD=0.35

# =============================================================================
# Inference — RunPod serverless (default)
# =============================================================================
# Endpoint ID from RunPod dashboard. POST to .../runsync with Bearer auth.
INFERENCE_SERVER_URL=https://api.runpod.ai/v2/wid4pce4yufwbd
RUNPOD_API_KEY=rpa_your_runpod_api_key
INFERENCE_TIMEOUT_SECONDS=60
INFERENCE_BATCH_TIMEOUT_SECONDS=300
# Must be publicly reachable by RunPod workers (not localhost).
# Set this in .env on the machine running tagr-web — see docs/cloudflare-named-tunnel.md
# Quick tunnel example:
# API_CALLBACK_URL=https://your-subdomain.trycloudflare.com/api/v1/internal/inference-callback
# Named tunnel example:
# API_CALLBACK_URL=https://tagr.yourdomain.com/api/v1/internal/inference-callback
API_CALLBACK_URL=

BATCH_SIZE=20
BATCH_TIMEOUT_MS=50

# --- Optional Cloudflare Tunnel (permanent URL on your domain) ---
# Create at: Cloudflare Zero Trust -> Networks -> Tunnels -> Create tunnel
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
