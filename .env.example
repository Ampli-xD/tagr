# =============================================================================
# Database — Supabase (Postgres + pgvector)
# =============================================================================
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_POOL_PRE_PING=true
DB_ECHO=false

# =============================================================================
# Supabase Auth
# =============================================================================
# Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API -> JWT Secret (server-side only, never expose to browser)
SUPABASE_JWT_SECRET=your-jwt-secret

# =============================================================================
# Object storage (MinIO / S3-compatible)
# =============================================================================
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

STORAGE_ENDPOINT=http://storage:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=tagr-bucket
STORAGE_REGION=us-east-1
STORAGE_SIGNATURE_VERSION=s3v4

# =============================================================================
# FastAPI web server
# =============================================================================
WEB_PORT=8787
CORS_ALLOW_ORIGINS=*

SIMILARITY_THRESHOLD=0.35

# =============================================================================
# Inference service
# =============================================================================
INFERENCE_PORT=8001
INFERENCE_DEVICE=cpu
INFERENCE_SERVER_URL=http://inference:8001
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_BATCH_TIMEOUT_SECONDS=120
API_CALLBACK_URL=http://web:8000/api/v1/internal/inference-callback

BATCH_SIZE=10
BATCH_TIMEOUT_MS=50
