# =============================================================================
# Database — Supabase Supavisor POOLER (recommended)
# =============================================================================
# When the three pooler vars below are set, DATABASE_URL is built automatically
# and takes priority over a manual DATABASE_URL.
#
# Dashboard: Project Settings -> Database -> Connection string -> Pooler
#
# Transaction mode (default, port 6543) — best for app servers / Docker:
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
SUPABASE_POOLER_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_POOLER_PORT=6543
SUPABASE_DB_NAME=postgres
#
# Session mode alternative (port 5432 on the pooler host, same user format):
# SUPABASE_POOLER_PORT=5432
#
# Or pass a full URL instead (direct or pooler) — used only when pooler vars above are unset:
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

DB_POOL_PRE_PING=true
DB_ECHO=false

# =============================================================================
# Supabase Auth
# =============================================================================
# --- Supabase Auth ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Legacy fallback (older projects only):
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret

# =============================================================================
# Object storage (MinIO / S3-compatible)
# =============================================================================
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

STORAGE_ENDPOINT=http://storage:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=tagr-bucket
STORAGE_REGION=us-east-1
STORAGE_SIGNATURE_VERSION=s3v4

# =============================================================================
# FastAPI web server
# =============================================================================
WEB_PORT=8787
CORS_ALLOW_ORIGINS=*

SIMILARITY_THRESHOLD=0.35

# =============================================================================
# Inference service
# =============================================================================
INFERENCE_PORT=8001
INFERENCE_DEVICE=cpu
INFERENCE_SERVER_URL=http://inference:8001
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_BATCH_TIMEOUT_SECONDS=120
API_CALLBACK_URL=http://web:8000/api/v1/internal/inference-callback

BATCH_SIZE=10
BATCH_TIMEOUT_MS=50
