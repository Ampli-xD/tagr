# =============================================================================
# Database — Supabase (Postgres + pgvector)
# =============================================================================
# Primary connection string used by the API (SQLAlchemy + psycopg driver).
# Get it from Supabase: Project Settings -> Database -> Connection string -> URI,
# then convert the scheme from "postgresql://" to "postgresql+psycopg://" and
# append "?sslmode=require".
#
# Direct connection (port 5432) example:
#   postgresql+psycopg://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#
# Connection pooler / Supavisor (session mode, port 5432) example:
#   postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# NOTE: If you use the transaction pooler (port 6543), also add
#   &prepare_threshold=0
# because transaction-mode pooling does not support prepared statements.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/tagr_db
DB_POOL_PRE_PING=true
DB_ECHO=false

# Legacy local-Postgres settings (only needed if you re-enable the `db` service
# in docker-compose; ignored when DATABASE_URL points at Supabase).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tagr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================================================
# Object storage (MinIO / S3-compatible)
# =============================================================================
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

STORAGE_ENDPOINT=http://storage:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=tagr-bucket
STORAGE_REGION=us-east-1
STORAGE_SIGNATURE_VERSION=s3v4

# =============================================================================
# FastAPI web server
# =============================================================================
WEB_PORT=8787
CORS_ALLOW_ORIGINS=*

# --- Auth / JWT ---
JWT_SECRET=tagr-super-secret-key-12345
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# --- OTP (mock flow) ---
MOCK_OTP_CODE=123456
OTP_EXPIRY_MINUTES=5

# --- Face matching ---
# A face matches a user when (1 - cosine_distance) >= SIMILARITY_THRESHOLD.
SIMILARITY_THRESHOLD=0.35

# =============================================================================
# Inference service
# =============================================================================
INFERENCE_PORT=8001
INFERENCE_DEVICE=cpu
INFERENCE_SERVER_URL=http://inference:8001
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_BATCH_TIMEOUT_SECONDS=120
API_CALLBACK_URL=http://web:8000/api/v1/internal/inference-callback

# --- Batcher ---
BATCH_SIZE=10
BATCH_TIMEOUT_MS=50
